{
  "permissions": {
    "allow": ["mcp__bold__*"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__bold__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ledger.sh\"",
            "shell": "bash",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__bold__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ledger.sh\"",
            "shell": "bash",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/anti-cheat.sh\"",
            "shell": "bash",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
